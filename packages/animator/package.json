{
  "name": "@stickshorts/animator",
  "version": "0.1.0",
  "private": true,
  "description": "Remotion project: stickman rig, actions, motion graphics, and episode compositions.",
  "scripts": {
    "studio": "remotion studio src/index.ts",
    "typecheck": "tsc --noEmit",
    "render:sheet": "remotion still src/index.ts CharacterSheet out/character-sheet.png",
    "render:frame": "remotion still src/index.ts ShortsFrame out/shorts-frame.png --frame=150",
    "render:rigtest": "remotion render src/index.ts RigTest out/rig-test.mp4"
  },
  "dependencies": {
    "@remotion/cli": "4.0.541",
    "@remotion/fonts": "4.0.541",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "remotion": "4.0.541"
  },
  "devDependencies": {
    "@types/react": "19.2.2",
    "typescript": "5.9.3"
  }
}
